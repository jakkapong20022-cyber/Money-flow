# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
PUBLIC_URL=https://budget.example.com      # URL HTTPS ของเซิร์ฟเวอร์ (ใช้แสดง Webhook URL)
ANTHROPIC_API_KEY=                          # เปิดระบบสแกนสลิป (ไม่ใส่ = สแกนสลิปไม่ได้)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ใส่ค่า LINE ที่หน้า "ตั้งค่า" ในแอปได้เลย หรือจะกำหนดเป็นค่าเริ่มต้นตรงนี้:
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=

# --- เข้าสู่ระบบด้วย LINE (LINE Login) — ไม่บังคับ ---
# สร้างช่องทาง "LINE Login" ใน Provider เดียวกับ Messaging API (เพื่อให้ userId ตรงกัน)
# ตั้ง Callback URL = <PUBLIC_URL>/auth/line/callback แล้วเปิดสถานะเป็น Published
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
